generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// СИСТЕМА ПОЛЬЗОВАТЕЛЕЙ И РОЛЕЙ
// ==========================================

model User {
  id               String           @id @default(uuid())
  nick             String?          @unique
  password         String?
  
  lastName         String
  firstName        String
  middleName       String?
  email            String?          @unique
  phone            String?
  
  role             UserRole         @default(STUDENT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  deaneryProfile   DeaneryProfile?
  botUsers         BotUser[]

  sentMessages     Message[]        @relation("SentByUser")
  receivedMessages Message[]        @relation("UserRecipient")
  sentDistributions Distribution[]  @relation("SentByUserForDistribution")

  @@index([role])
  @@index([lastName, firstName])
}

model StudentProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  student_id   String   @unique
  course       Int
  isLeader     Boolean  @default(false)

  groupId      String?
  group        Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([course])
}

model DeaneryProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model TeacherProfile {
  id          String              @id @default(uuid())
  userId      String              @unique
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[] // Исправлено: связь один-ко-многим
  subjects    Json?        
}

model TeacherAssignment {
  id               String         @id @default(uuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  groupId          String
  group            Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  roleInGroup      String?        // Например: "Лектор", "Лаборант"

  @@unique([teacherProfileId, groupId])
  @@index([groupId])
}

// ==========================================
// УЧЕБНАЯ СТРУКТУРА
// ==========================================

model Faculty {
  id           String       @id @default(uuid())
  name         String       @unique
  createdAt    DateTime     @default(now())
  departments  Department[]
  deaneries    DeaneryProfile[]
}

model Department {
  id           String           @id @default(uuid())
  name         String           @unique
  facultyId    String
  faculty      Faculty          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  groups       Group[]
  createdAt    DateTime         @default(now())

  @@index([facultyId])
}

model Group {
  id           String              @id @default(uuid())
  name         String              @unique
  departmentId String
  department   Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  course       Int
  students     StudentProfile[]  
  teachers     TeacherAssignment[] // Преподаватели этой группы
  createdAt    DateTime            @default(now())

  @@index([departmentId])
}

// ==========================================
// ИНТЕГРАЦИЯ С БОТАМИ
// ==========================================

model Bot {
  id        String      @id @default(uuid())
  platform  BotPlatform
  token     String      @unique
  name      String
  createdAt DateTime    @default(now())
  isActive  Boolean     @default(true)
  users     BotUser[]
  messages  Message[]
  settings  Json?

  @@unique([platform])
  @@map("bots")
}

model BotUser {
  id         String   @id @default(uuid())
  userId     String   
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId      String
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  externalId String
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([userId, botId])
  @@index([externalId])
  @@map("bot_users")
}

// ==========================================
// КОММУНИКАЦИИ
// ==========================================

model Distribution {
  id           String      @id @default(uuid())
  text         String
  createdAt    DateTime    @default(now())
  
  senderId     String
  sender       User        @relation("SentByUserForDistribution", fields: [senderId], references: [id], onDelete: Cascade)

  targetType   TargetType
  targetId     String?
  course       Int?        
  platform     BotPlatform

  messages     Message[]

  @@index([createdAt])
  @@index([senderId])
}

model Message {
  id             String        @id @default(uuid())
  text           String
  createdAt      DateTime      @default(now())
  senderType     SenderType    
  
  senderId       String?
  sender         User?         @relation("SentByUser", fields: [senderId], references: [id], onDelete: SetNull)

  recipientId    String?
  recipient      User?         @relation("UserRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  distributionId String?
  distribution   Distribution? @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  
  parentId       String?
  parent         Message?      @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Message[]     @relation("MessageReplies")

  botId          String?
  bot            Bot?          @relation(fields: [botId], references: [id], onDelete: SetNull)
  platform       BotPlatform   
  externalId     String?       

  @@index([createdAt])
  @@index([senderId])
  @@index([recipientId])
  @@index([distributionId])
}

enum SenderType {
  SYSTEM
  ADMIN
  DEANERY
  TEACHER
  STUDENT
}



enum TargetType {
  USER
  GROUP
  DEPARTMENT
  FACULTY
  COURSE
  ALL
}

enum BotPlatform {
  TELEGRAM
  VK
  OK
  ALL
}

enum UserRole {
  ADMIN
  DEANERY
  TEACHER
  STUDENT
}