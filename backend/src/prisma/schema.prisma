generator  client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model DecaneryStaff  {
    id          String @id @default(uuid())
    nick        String @unique
    password    String 
    createdAt   DateTime @default(now())
    dialogue    Dialogue[]
}

model Student {
    id          String @id @default(uuid())
    student_id  String @unique
    name        String
    course      String
    department  String
    directions  String
    group       String
    createdAt   DateTime @default(now())
}
model Dialogue {
    id          String @id @default(uuid())
    course      String 
    department  String
    directions  String
    group       String @unique
    message     String
    createdAt   DateTime @default(now())
    authorId    String  
    author      DecaneryStaff  @relation(fields: [authorId], references: [id])

}