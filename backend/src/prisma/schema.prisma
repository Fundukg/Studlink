generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Основные учебные сущности
model Staff {
  id               String    @id @default(uuid())
  nick             String    @unique
  password         String
  
  // Раздельное ФИО для удобной сортировки и фильтрации
  lastName         String    // Фамилия
  firstName        String    // Имя
  middleName       String?   // Отчество (опционально)
  
  role             RoleStaff @default(TEACHER)
  createdAt        DateTime  @default(now())
  
  sentMessages     Message[] @relation("SentByStaff")
  receivedMessages Message[] @relation("StaffRecipient")
  sentDistribution Distribution[] @relation("SentByStaffForDistribution")
  @@index([role]) // Быстрая фильтрация по ролям
  @@index([lastName, firstName]) // Оптимизация поиска по ФИО
}

model Student {
  id               String    @id @default(uuid())
  student_id       String    @unique // Номер зачетки/билета
  name             String    // Здесь можно оставить одной строкой, если нет нужды в сложной сортировке
  course           String
    
  groupId          String?
  group            Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  
  createdAt        DateTime  @default(now())
  
  sentMessages     Message[] @relation("SentByStudent")
  receivedMessages Message[] @relation("StudentRecipient")
  botUsers         BotUser[]

  @@index([groupId])
  @@index([course])
}

model Faculty {
  id          String       @id @default(uuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  departments Department[]
  messages    Message[]
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  facultyId String
  faculty   Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  groups    Group[]
  messages  Message[]
  createdAt DateTime  @default(now())

  @@index([facultyId])
}

model Group {
  id           String     @id @default(uuid())
  name         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students     Student[]  
  messages     Message[]
  createdAt    DateTime   @default(now())

  @@index([departmentId])
}

model Bot {
  id        String      @id @default(uuid())
  platform  BotPlatform
  token     String      @unique
  name      String
  createdAt DateTime    @default(now())
  isActive  Boolean     @default(true)
  users     BotUser[]
  messages  Message[]
  settings  Json?

  @@unique([platform])
  @@map("bots")
}

model BotUser {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  botId      String
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  externalId String // ID пользователя в мессенджереq
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([studentId, botId])
  @@index([externalId])
  @@map("bot_users")
}
model Distribution {
  id           String      @id @default(uuid())
  text         String
  createdAt    DateTime    @default(now())
  
  // Кто инициировал
  staffId      String
  staff      Staff?     @relation("SentByStaffForDistribution", fields: [staffId], references: [id], onDelete: Cascade)

  // Параметры таргетинга (чтобы знать, кому отправляли)
  targetType   TargetType
  targetId     String?     // UUID группы, кафедры или факультета
  course       Int?        // Если рассылка по курсу
  platform     BotPlatform // ALL, VK, TG, OK

  // Связь с конкретными сообщениями
  messages     Message[]

  @@index([createdAt])
}
model Message {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())

  senderType SenderType
  
  // Кто отправил
  staffId    String?
  staff      Staff?     @relation("SentByStaff", fields: [staffId], references: [id], onDelete: SetNull)
  studentId  String?
  student    Student?   @relation("SentByStudent", fields: [studentId], references: [id], onDelete: Cascade)

  targetType TargetType
  distributionId String?
  distribution   Distribution? @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  // Получатели (Личные)
  recipientStudentId String?
  recipientStudent   Student? @relation("StudentRecipient", fields: [recipientStudentId], references: [id], onDelete: Cascade)
  recipientStaffId   String?
  recipientStaff     Staff?   @relation("StaffRecipient", fields: [recipientStaffId], references: [id], onDelete: Cascade)

  // Получатели (Групповые/Структурные)
  course       Int?
  groupId      String?
  group        Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  facultyId    String?
  faculty      Faculty?    @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  // Иерархия ответов
  parentId String?
  parent   Message?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Message[] @relation("MessageReplies")

  // Интеграция с ботами
  botId      String?
  bot        Bot?    @relation(fields: [botId], references: [id], onDelete: SetNull)
  platform   BotPlatform
  externalId String? 

  @@index([createdAt]) // Важно для быстрой подгрузки истории сообщений
  @@index([groupId])
  @@index([staffId])
  @@index([studentId])
  @@index([distributionId])
}

// Обновленные enums
enum SenderType {
  STAFF
  STUDENT
  SYSTEM
}

enum TargetType {
  STUDENT // Личное сообщение студенту
  STAFF // Личное сообщение сотруднику
  GROUP // Группе
  DEPARTMENT // Кафедре
  FACULTY // Факультету
  COURSE // Курсу
  ALL // Всем студентам
}

enum BotPlatform {
  TELEGRAM
  VK
  OK
  ALL
}

enum RoleStaff {
  ADMIN
  DEANERY     // Сотрудник деканата (управление студентами/группами)
  TEACHER     // Преподаватель (только сообщения и свои курсы)
}
