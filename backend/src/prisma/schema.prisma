generator  client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id          String @id @default(uuid())
    nick        String @unique
    password    String 
    createdAt   DateTime @default(now())
}
model Dialogue {
    id          String @id @default(uuid())
    course      String 
    department  String
    directions  String
    group       String @unique
    message     String
    createdAt   DateTime @default(now())
}